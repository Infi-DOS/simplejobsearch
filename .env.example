# Shared runtime
JOBSEARCH_DB_PATH=./jobs.db
JOBSEARCH_TIMEZONE=Europe/Amsterdam

# NiceGUI
WEB_HOST=0.0.0.0
WEB_PORT=5000
PUBLIC_BASE_URL=

# Optional Windows Task Scheduler lifecycle. Leave false for the normal
# foreground web/continue behavior.
WINDOWS_TASK_AUTOMATION=false
WINDOWS_PIPELINE_TASK_NAME=JobSimpleSearch-Continue
WINDOWS_PORTAL_STOP_TASK_NAME=JobSimpleSearch-ClosePortal
WINDOWS_PORTAL_SHUTDOWN_DELAY_SECONDS=3

# Discovery fallback for queries without an explicit market. The production
# query table contains five Netherlands and five Switzerland searches.
SEARCH_LOCATION=Netherlands
SEARCH_COUNTRY=Netherlands
SEARCH_HOURS_OLD=24
SEARCH_RESULTS_WANTED=1000
SEARCH_FETCH_DESCRIPTIONS=false
SEARCH_DELAY_MIN_SECONDS=15
SEARCH_DELAY_MAX_SECONDS=30
# 0 processes every eligible job in the selected batch; a positive value caps it.
DETAILS_MAX_JOBS_PER_RUN=0
DETAILS_MAX_ATTEMPTS_PER_JOB=3
DETAILS_DELAY_MIN_SECONDS=4
DETAILS_DELAY_MAX_SECONDS=8
DETAILS_STOP_AFTER_EMPTY=3

# Google GenAI / Gemma
GEMINI_API_KEY=
JOB_AI_MODEL=gemma-4-31b-it
GEMMA_THINKING_LEVEL=HIGH
GEMMA_TEMPERATURE=1.0
GEMMA_TOP_P=0.95
GEMMA_TOP_K=64
AI_TARGET_RPM=25
AI_MAX_CONCURRENCY=25
AI_PROVIDER_TPM=16000
AI_TPM_SAFETY_FACTOR=0.90
AI_CHARS_PER_TOKEN_ESTIMATE=3.5
AI_MAX_JOBS_PER_RUN=0
AI_MAX_ATTEMPTS_PER_JOB=3
AI_MAX_SCHEMA_REPAIR_ATTEMPTS=1
AI_RETRY_BASE_SECONDS=2
AI_RETRY_MAX_SECONDS=30
AI_PROBE_MODE=false

# SMTP
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# APScheduler (timezone comes from JOBSEARCH_TIMEZONE)
SCHEDULER_ENABLED=true
SCHEDULER_SEARCH_HOUR=22
SCHEDULER_SEARCH_MINUTE=30
SCHEDULER_REMINDER_HOUR=8
SCHEDULER_REMINDER_MINUTE=0
